# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Gemini API via Google AI Studio (free tier): https://aistudio.google.com/apikey
# Never commit the real key (.env is git-ignored).
GOOGLE_GENAI_USE_ENTERPRISE=false
GEMINI_API_KEY=your-api-key-here

# --- SF permit assistant ---
# DataSF Building Permits API (public, no key). Optional Socrata app token for
# higher rate limits; injected from Secret Manager in production.
# DATASF_URL=https://data.sf.gov/resource/i98e-djp9.json
# SOCRATA_APP_TOKEN=
# DATASF_CACHE=on            # local cache (24 h TTL)
# MAX_TOOL_CALLS_PER_REQUEST=10
# AGENT_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=gemini-3.1-flash-lite
# RAG_EMBEDDINGS=auto        # auto | gemini | local (offline fallback)
